app.put('/api/manual-entry/:id', async (req, res) => {
  let client;
  try {
    const { id } = req.params;
    const p = req.body || {};

    const incomingType = (p.type ?? p.flow_type) || null;   // 'IN'|'OUT'|'CF_IN'|'CF_OUT'|null
    const account   = (p.account_name || p.account || '').toString().trim();
    const content   = p.content != null ? String(p.content) : null;
    const memo      = p.memo    != null ? String(p.memo)    : null;
    const currency  = p.currency != null ? String(p.currency) : null;
    const tradeDate = p.trade_date ? String(p.trade_date) : null; // 'YYYY-MM-DD'
    const segInput  = p.segment != null ? String(p.segment) : null;
    const cat2      = p.category2_name !== undefined ? (p.category2_name === '' ? null : String(p.category2_name)) : undefined;
    const cat1      = p.category_name  !== undefined ? (p.category_name  === '' ? null : String(p.category_name))  : undefined;
    const amountStr = p.amount != null ? String(p.amount) : null;
    const rateStr   = p.rate   != null ? String(p.rate)   : null;

    const sets = [];
    const vals = [];
    const pushSet = (col, sqlFrag, val) => {
      sets.push(`${col} ${sqlFrag.replace('$N', `$${vals.length + 1}`)}`);
      vals.push(val);
    };

    if (segInput)           pushSet('segment',        '= $N::app.segment_type', segInput);
    if (cat1 !== undefined) pushSet('category_name',  '= $N',                    cat1);
    if (cat2 !== undefined) pushSet('category2_name', '= $N',                    cat2);
    if (content !== null)   pushSet('content',        '= $N',                    content);
    if (memo !== null)      pushSet('memo',           '= $N',                    memo);
    if (incomingType && ['IN','OUT','CF_IN','CF_OUT'].includes(incomingType)) {
      pushSet('flow_type', '= $N', incomingType);
    }
    if (currency)           pushSet('currency',       '= $N',                    currency);
    if (account)            pushSet('account_name',   '= $N',                    account);
    if (tradeDate)          pushSet('trade_date',     '= $N::date',              tradeDate);

    let amtParam = null, rateParam = null;
    if (p.hasOwnProperty('amount')) {
      const amt = amountStr == null || amountStr === '' ? null : Number(amountStr);
      pushSet('amount', '= CAST($N AS numeric(20,8))', amt);
      if (amt != null) amtParam = vals.length;
    }
    if (p.hasOwnProperty('rate')) {
      const r = rateStr == null || rateStr === '' ? null : Number(rateStr);
      pushSet('rate', '= CAST($N AS numeric(20,8))', r);
      if (r != null) rateParam = vals.length;
    }
    if (p.hasOwnProperty('amount') || p.hasOwnProperty('rate')) {
      const amtExpr  = (amtParam  ? `$${amtParam}::numeric`  : 'amount');
      const rateExpr = (rateParam ? `$${rateParam}::numeric` : 'rate');
      sets.push(`jpy_amount = CASE
        WHEN ${amtExpr} IS NULL OR ${rateExpr} IS NULL THEN jpy_amount
        ELSE CAST((${amtExpr}) * (${rateExpr}) AS numeric(20,4)) END`);
    }

    if (sets.length === 0) return res.status(400).json({ error: 'No fields to update' });

    const sql = `
      UPDATE app.manual_entry AS m
         SET ${sets.join(', ')}
       WHERE m.id = $${vals.length + 1}
       RETURNING m.id, m.trade_date, m.account_name, m.flow_type,
                 m.category_name, m.category2_name, m.content, m.memo,
                 m.amount, m.currency, m.rate, m.jpy_amount, m.segment;
    `;
    vals.push(Number(id));

    client = await pool.connect();
    await client.query('BEGIN');
    const { rows, rowCount } = await client.query(sql, vals);
    await client.query('COMMIT');
    client.release();

    if (rowCount === 0) return res.status(404).json({ error: 'Not found' });
    return res.json({ status: 'ok', row: rows[0] });
  } catch (e) {
    if (client) try { await client.query('ROLLBACK'); } catch {}
    console.error('[manual-entry PUT] error:', e);
    return res.status(/timeout/i.test(String(e)) ? 504 : 500).json({ error: String(e.message || e) });
  } finally {
    if (client) try { client.release(); } catch {}
  }
});
